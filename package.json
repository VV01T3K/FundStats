{
	"name": "fundstats",
	"version": "2.0.0",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"effect": "4.1.4",
			"@effect/vitest": "4.1.4",
			"@effect/platform-bun": "4.1.4",
			"@effect/sql-pg": "4.1.4",
			"drizzle-orm": "1.0.0-rc.5",
			"drizzle-kit": "1.0.0-rc.5",
			"vitest": "5.0.5",
			"vite": "8.3.5",
			"@types/bun": "1.4.4",
			"@tanstack/react-start": "1.169.5",
			"nitro": "3.0.261103-rc",
			"@testcontainers/postgresql": "12.2.1"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "bun run --filter '@fundstats/web' --filter '@fundstats/collector' dev",
		"build": "bun run --filter '@fundstats/web' --filter '@fundstats/collector' build",
		"start": "bun run --filter '@fundstats/web' start",
		"collector": "bun run --filter '@fundstats/collector' start",
		"collect": "bun run --filter '@fundstats/collector' collect",
		"db:migrate": "bun run --filter '@fundstats/collector' migrate",
		"db:generate": "bun run --filter '@fundstats/db' db:generate",
		"check": "bun run fmt:check && bun run lint && bun run typecheck && bun run knip",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"lint": "oxlint",
		"typecheck": "effect-tsgo tsc --noEmit && bun run --filter '@fundstats/*' typecheck",
		"test": "bun --bun vitest run --maxWorkers=4",
		"knip": "knip",
		"sync:repos": "bun scripts/sync-repos.ts"
	},
	"devDependencies": {
		"@effect/platform-bun": "catalog:",
		"@effect/tsgo": "0.64.1",
		"@effect/vitest": "catalog:",
		"@oxlint/plugins": "1.89.0",
		"@socketsecurity/bun-security-scanner": "1.1.3",
		"@types/bun": "catalog:",
		"effect": "catalog:",
		"knip": "6.44.1",
		"oxfmt": "0.74.0",
		"oxlint": "1.89.0",
		"oxlint-tsgolint": "7.0.2004",
		"typescript": "7.0.2",
		"vitest": "catalog:"
	},
	"packageManager": "bun@1.4.4"
}
