{
	"name": "fundstats",
	"version": "2.0.0",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"dev": "bun run --filter '@fundstats/web' --filter '@fundstats/collector' dev",
		"build": "bun run --filter '@fundstats/web' build",
		"start": "bun run --filter '@fundstats/web' start",
		"collector": "bun run --filter '@fundstats/collector' start",
		"collect": "bun apps/collector/src/bin.ts collect",
		"db:migrate": "bun apps/collector/src/bin.ts migrate",
		"db:generate": "bun run --filter '@fundstats/db' db:generate",
		"typecheck": "effect-tsgo tsc --noEmit && bun run --filter '@fundstats/*' typecheck",
		"lint": "vp lint",
		"test": "vitest run",
		"fmt": "vp fmt",
		"check": "vp check",
		"knip": "knip",
		"sync:repos": "bun scripts/sync-repos.ts"
	},
	"devDependencies": {
		"@effect/platform-node": "4.1.4",
		"@effect/tsgo": "0.64.1",
		"@effect/vitest": "4.1.4",
		"@oxlint/plugins": "1.89.0",
		"@tailwindcss/vite": "4.3.5",
		"@tanstack/devtools-vite": "^0.8.6",
		"@tanstack/react-start": "1.169.5",
		"@types/node": "^26.6.6",
		"@vitejs/plugin-react": "6.3.0",
		"effect": "4.1.4",
		"knip": "6.44.1",
		"nitro": "3.0.261103-rc",
		"typescript": "7.0.2",
		"vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
		"vite-plus": "1.4.0",
		"vitest": "5.0.5"
	},
	"overrides": {
		"vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
		"vitest": "5.0.5"
	}
}
