---
import { Image } from "astro:assets";
import { cacheImage } from "@/lib/myutils";

interface Props {
    coinSymbol: string;
    coinId: number;
}

const { coinSymbol, coinId } = Astro.props;

const imageSrc = await cacheImage(
    `https://s2.coinmarketcap.com/static/img/coins/64x64/${coinId}.png`,
    coinSymbol
);
---

<Image src={imageSrc} alt={coinSymbol} width={24} height={24} class="rounded-full mr-2 inline-block" />
