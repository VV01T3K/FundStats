---
export const partial = true;
export const prerender = false;

// Errors must not be cached, so they don't stick in the browser.
Astro.response.headers.set("Cache-Control", "no-store");

import {
    Table,
    TableBody,
    TableCaption,
    TableCell,
    TableHead,
    TableHeader,
    TableRow,
} from "../../components/ui/table";
import { Button } from "../../components/ui/button";

import { Icon } from "astro-icon/components";

import { getColorClass, getHighlightClass } from "../../lib/myutils";

// The free tickers API only has real values up to 7d; its 30d and 1y fields are placeholders
// (the same number for every coin), so they are not offered here.
const periods = ["7d", "24h"] as const;
type Period = (typeof periods)[number];

const sort: Period = periods.includes(Astro.params.sort as Period) ? (Astro.params.sort as Period) : "7d";
const nextSort = periods[(periods.indexOf(sort) + 1) % periods.length];
const safeThreshold = Astro.params.threshold ? parseFloat(Astro.params.threshold) : 0;
const thresholds = [5, 10, 20, 30, 40, 50];

interface Coin {
    id: string;
    name: string;
    rank: number;
    quotes: {
        PLN: Record<`percent_change_${Period}`, number | null>;
    };
}

// Public keyless API (https://api.coinpaprika.com). It returns ~2000 coins ordered by rank.
const url = "https://api.coinpaprika.com/v1/tickers?quotes=PLN";

let coins: Coin[] = [];
let error = "";
try {
    const response = await fetch(url, { headers: { Accept: "application/json" } });
    if (response.ok) {
        const data: Coin[] = await response.json();
        coins = data.filter((coin) => coin.rank > 0 && coin.rank <= 100);
        Astro.response.headers.set("Cache-Control", "private, max-age=1800");
    } else {
        error =
            response.status === 429
                ? "CoinPaprika rate limit hit, try again in a minute."
                : `CoinPaprika error ${response.status}`;
    }
} catch (e) {
    error = `CoinPaprika request failed: ${e}`;
}

const change = (coin: Coin) => coin.quotes.PLN[`percent_change_${sort}`];
// Coins without history for the period go to the bottom.
coins.sort((a, b) => (change(b) ?? -Infinity) - (change(a) ?? -Infinity));

const date = new Date();
const day = date.getDate();
const month = date.getMonth() + 1; //January is 0!
const year = date.getFullYear();
const hours = date.getHours();
const minutes = date.getMinutes();

const currentTime = `${String(day).padStart(2, "0")}.${String(month).padStart(2, "0")}.${year} ${hours}:${String(minutes).padStart(2, "0")}`;
---

<div>
    <menu class="flex justify-evenly">
        {
            thresholds.map((t) => (
                <Button
                    variant={safeThreshold === t ? "default" : "secondary"}
                    class="text-lg transition-transform hover:scale-105 active:scale-95"
                    hx-trigger=" click throttle:1s"
                    hx-get={`/partials/PaprikaTable-${sort}-${t}`}
                    hx-swap="innerHTML transition:true"
                    hx-indicator="#spinner"
                    hx-target="#response-div"
                    aria-label={`change threshold to ${t}%`}
                >
                    {t} %
                </Button>
            ))
        }
    </menu>
    <div class="text-base mt-5 opacity-60">
        Time: {currentTime} · Source: CoinPaprika free API (top 100 by rank, no 30d/1y data)
    </div>
    {error && <div class="text-base mt-5 text-red-myred">{error}</div>}
    <Table>
        <TableCaption>
            <a class="flex text-base justify-center items-center" href="#top"
                ><Icon size={16} name="line-md:upload-loop" />Go to the top of the page<Icon
                    size={16}
                    name="line-md:upload-loop"
                /></a
            >
        </TableCaption>
        <TableHeader>
            <TableRow>
                <TableHead class="w-[230px]">ID</TableHead>
                <TableHead>Name</TableHead>
                <TableHead
                    class="text-right pr-20 hover:text-blue-500 cursor-pointer"
                    hx-trigger=" click throttle:1s"
                    hx-get=`/partials/PaprikaTable-${nextSort}-${safeThreshold}`
                    hx-swap="innerHTML transition:true"
                    hx-indicator="#spinner"
                    hx-target="#response-div"
                >
                    {`Change (${sort})`}<Icon style={"display: inline"} size={16} name="line-md:arrow-down" />
                </TableHead>
            </TableRow>
        </TableHeader>
        <TableBody>
            {
                coins.map((coin, index) => (
                    <TableRow class={getHighlightClass(change(coin) ?? 0, safeThreshold)}>
                        <TableCell>{index + 1}</TableCell>
                        <TableCell>{coin.name}</TableCell>
                        <TableCell class={`text-right pr-20 ${getColorClass(change(coin) ?? 0)}`}>
                            {change(coin) == null ? "–" : `${change(coin)!.toFixed(2)} %`}
                        </TableCell>
                    </TableRow>
                ))
            }
        </TableBody>
    </Table>
</div>
