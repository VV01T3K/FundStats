---
export const partial = true;
export const prerender = false;

import {
    Table,
    TableBody,
    TableCaption,
    TableCell,
    TableHead,
    TableHeader,
    TableRow,
} from "../../components/ui/table";
import { Button } from "../../components/ui/button";

import { Icon } from "astro-icon/components";

import { getColorClass, getHighlightClass } from "../../lib/myutils";

const { sort, threshold } = Astro.params as { sort: "1y" | "1q"; threshold: string };
const safeThreshold = threshold ? parseFloat(threshold) : 0;

const options = {
    method: "GET",
    headers: {
        "sec-ch-ua": '"Not A(Brand";v="99", "Brave";v="121", "Chromium";v="121"',
        Accept: "application/json, text/plain, */*",
        Referer: "https://coinpaprika.com/",
        DNT: "1",
        "sec-ch-ua-mobile": "?0",
        "User-Agent":
            "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/121.0.0.0 Safari/537.36",
        "sec-ch-ua-platform": '"Windows"',
    },
};
const queryOptions = new URLSearchParams({
    section: "longterm",
    all: "false",
    expand: "longterm,price_stats",
    "sort[sort]": `change_${sort}_chart`,
    "sort[sortorder]": "desc",
    tagID: "",
    "filters[coins]": "true",
    "filters[tokens]": "true",
    currency: "pln",
});
const url = `https://api-frontend.coinpaprika.com/ajax/coins/1?${queryOptions}`;
// https://api-frontend.coinpaprika.com/ajax/coins/1?section=longterm&all=false&expand=longterm,price_stats&sort[sort]=change_1y_chart&sort[sortorder]=desc&tagID=&filters[coins]=true&filters[tokens]=true&currency=pln
const response = await fetch(url, options);
const data = await response.json();
const coins = data.data;
// console.log(coins);

interface PriceStats {
    usd: {
        change_1q: number;
        change_1y: number;
    };
    // add other properties as needed
}
interface Coin {
    id: number;
    name: string;
    price_stats: PriceStats;
    // add other properties as needed
}
---

<div>
    <menu class="flex justify-evenly">
        <Button
            variant={safeThreshold === 10 ? "default" : "secondary"}
            class="text-lg transition-transform hover:scale-105 active:scale-95"
            hx-trigger=" click"
            hx-get=`/partials/PaprikaTable-${sort}-10}`
            hx-swap="innerHTML transition:true"
            hx-indicator="#spinner"
            hx-target="#response-div"
            aria-label="change threshold to 10%"
        >
            10 %
        </Button>
        <Button
            variant={safeThreshold === 20 ? "default" : "secondary"}
            class="text-lg transition-transform hover:scale-105 active:scale-95"
            hx-trigger=" click"
            hx-get=`/partials/PaprikaTable-${sort}-20}`
            hx-swap="innerHTML transition:true"
            hx-indicator="#spinner"
            hx-target="#response-div"
            aria-label="change threshold to 20%"
        >
            20 %
        </Button>
        <Button
            variant={safeThreshold === 30 ? "default" : "secondary"}
            class="text-lg transition-transform hover:scale-105 active:scale-95"
            hx-trigger=" click"
            hx-get=`/partials/PaprikaTable-${sort}-30}`
            hx-swap="innerHTML transition:true"
            hx-indicator="#spinner"
            hx-target="#response-div"
            aria-label="change threshold to 30%"
        >
            30 %
        </Button>
        <Button
            variant={safeThreshold === 40 ? "default" : "secondary"}
            class="text-lg transition-transform hover:scale-105 active:scale-95"
            hx-trigger=" click"
            hx-get=`/partials/PaprikaTable-${sort}-40}`
            hx-swap="innerHTML transition:true"
            hx-indicator="#spinner"
            hx-target="#response-div"
            aria-label="change threshold to 40%"
        >
            40 %
        </Button>
        <Button
            variant={safeThreshold === 50 ? "default" : "secondary"}
            class="text-lg transition-transform hover:scale-105 active:scale-95"
            hx-trigger=" click"
            hx-get=`/partials/PaprikaTable-${sort}-50}`
            hx-swap="innerHTML transition:true"
            hx-indicator="#spinner"
            hx-target="#response-div"
            aria-label="change threshold to 50%"
        >
            50 %
        </Button>
    </menu>
    <Table>
        <TableCaption>
            <a style="display: flex;justify-content: center; align-items: center;" href="#top"
                ><Icon size={16} name="line-md:upload-loop" />Go to the top of the page<Icon
                    size={16}
                    name="line-md:upload-loop"
                /></a
            >
        </TableCaption>
        <TableHeader>
            <TableRow>
                <TableHead class="w-[230px]">ID</TableHead>
                <TableHead>Name</TableHead>
                <TableHead
                    class="text-right pr-20 hover:text-blue-500 cursor-pointer"
                    hx-trigger=" click"
                    hx-get=`/partials/PaprikaTable-${sort === "1y" ? "1q" : "1y"}-${safeThreshold}`
                    hx-swap="innerHTML transition:true"
                    hx-indicator="#spinner"
                    hx-target="#response-div"
                >
                    {`Change (${sort})`}<Icon style={"display: inline"} size={16} name="line-md:arrow-down" />
                </TableHead>
            </TableRow>
        </TableHeader>
        <TableBody>
            {
                coins.map((coin: Coin, index: number) => (
                    <TableRow
                        class={getHighlightClass(coin.price_stats.usd[`change_${sort}`] ?? 0, safeThreshold)}
                    >
                        <TableCell>{index + 1}</TableCell>
                        <TableCell>{coin.name}</TableCell>
                        <TableCell
                            class={`text-right pr-20 ${getColorClass(coin.price_stats.usd[`change_${sort}`] ?? 0)}`}
                        >
                            {coin.price_stats.usd[`change_${sort}`]} %
                        </TableCell>
                    </TableRow>
                ))
            }
        </TableBody>
    </Table>
</div>
