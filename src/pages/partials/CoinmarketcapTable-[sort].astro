---
export const partial = true;
export const prerender = false;

import {
    Table,
    TableBody,
    TableCaption,
    TableCell,
    TableHead,
    TableHeader,
    TableRow,
} from "../../components/ui/table";

// import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

import { getColorClass } from "../../lib/myutils";

const { sort } = Astro.params as { sort: "7d" | "30d" | "60d" | "90d" };

const options = {
    method: "GET",
    headers: {
        accept: "application/json, text/plain, */*",
        "accept-language": "pl-PL,pl;q=0.7",
        Referer: "https://coinmarketcap.com/",
        "Referrer-Policy": "origin-when-cross-origin",
    },
};
const queryOptions = new URLSearchParams({
    start: "1",
    limit: "100",
    sortBy: `rank`,
    sortType: "desc",
    convert: "USD,BTC,ETH",
    cryptoType: "all",
    tagType: "all",
    audited: "false",
    aux: "ath,atl,high24h,low24h,num_market_pairs,cmc_rank,date_added,max_supply,circulating_supply,total_supply,volume_7d,volume_30d,self_reported_circulating_supply,self_reported_market_cap",
});
const url = `https://api.coinmarketcap.com/data-api/v3/cryptocurrency/listing?${queryOptions}`;
// https://api.coinmarketcap.com/data-api/v3/cryptocurrency/listing?start=1&limit=100&sortBy=rank&sortType=desc&convert=USD,BTC,ETH&cryptoType=all&tagType=all&audited=false&aux=ath,atl,high24h,low24h,num_market_pairs,cmc_rank,date_added,max_supply,circulating_supply,total_supply,volume_7d,volume_30d,self_reported_circulating_supply,self_reported_market_cap

const response = await fetch(url, options);
const data = await response.json();

const coins = data.data.cryptoCurrencyList.sort((a: Coin, b: Coin) => {
    const aQuote = a.quotes.find((quote) => quote.name === "USD");
    const bQuote = b.quotes.find((quote) => quote.name === "USD");
    if (sort === "7d") {
        return (bQuote?.percentChange7d ?? 0) - (aQuote?.percentChange7d ?? 0);
    } else if (sort === "30d") {
        return (bQuote?.percentChange30d ?? 0) - (aQuote?.percentChange30d ?? 0);
    } else if (sort === "60d") {
        return (bQuote?.percentChange60d ?? 0) - (aQuote?.percentChange60d ?? 0);
    } else if (sort === "90d") {
        return (bQuote?.percentChange90d ?? 0) - (aQuote?.percentChange90d ?? 0);
    }
    return 0;
});

interface Quote {
    name: string;
    percentChange30d: number;
    percentChange60d: number;
    percentChange90d: number;
    percentChange7d: number;
}

interface Coin {
    id: number;
    name: string;
    quotes: Quote[];
    cmcRank: number;
}

const timestamp = new Date(data.status.timestamp);
const day = timestamp.getDate();
const month = timestamp.getMonth() + 1; // JavaScript months are 0-based
const year = timestamp.getFullYear();
const hours = timestamp.getHours();
const minutes = timestamp.getMinutes();

const currentTime = `${String(day).padStart(2, "0")}.${String(month).padStart(2, "0")}.${year} ${hours}:${String(minutes).padStart(2, "0")}`;
---

<div class="text-base mt-5 opacity-60">
    Time: {currentTime}
</div>
<Table>
    <TableCaption>
        <a class="flex text-base justify-center items-center" href="#top"
            ><Icon size={16} name="line-md:upload-loop" />Go to the top of the page<Icon
                size={16}
                name="line-md:upload-loop"
            /></a
        >
    </TableCaption>
    <TableHeader>
        <TableRow>
            <TableHead class="w-[100px]">ID</TableHead>
            <TableHead>Name</TableHead>
            <TableHead
                class={`text-right hover:text-blue-500 cursor-pointer ${sort === "7d" ? "text-violet-600" : ""}`}
                hx-trigger=" click throttle:1s"
                hx-get=`/partials/CoinmarketcapTable-7d`
                hx-swap="innerHTML transition:true"
                hx-indicator="#spinner"
                hx-target="#response-div"
            >
                7d % {sort === "7d" && <Icon style={"display: inline"} size={16} name="line-md:arrow-down" />}
            </TableHead>
            <TableHead
                class={`text-right hover:text-blue-500 cursor-pointer ${sort === "30d" ? "text-violet-600" : ""}`}
                hx-trigger=" click throttle:1s"
                hx-get=`/partials/CoinmarketcapTable-30d`
                hx-swap="innerHTML transition:true"
                hx-indicator="#spinner"
                hx-target="#response-div"
            >
                30d % {
                    sort === "30d" && <Icon style={"display: inline"} size={16} name="line-md:arrow-down" />
                }
            </TableHead>
            <TableHead
                class=`text-right hover:text-blue-500 cursor-pointer ${sort === "60d" ? "text-violet-600" : ""}`
                hx-trigger=" click throttle:1s"
                hx-get="/partials/CoinmarketcapTable-60d"
                hx-swap="innerHTML transition:true"
                hx-indicator="#spinner"
                hx-target="#response-div"
            >
                60d % {
                    sort === "60d" && <Icon style={"display: inline"} size={16} name="line-md:arrow-down" />
                }
            </TableHead>
            <TableHead
                class=`text-right pr-100 hover:text-blue-500 cursor-pointer ${sort === "90d" ? "text-violet-600" : ""}`
                hx-trigger=" click throttle:1s"
                hx-get="/partials/CoinmarketcapTable-90d"
                hx-swap="innerHTML transition:true"
                hx-indicator="#spinner"
                hx-target="#response-div"
            >
                90d % {
                    sort === "90d" && <Icon style={"display: inline"} size={16} name="line-md:arrow-down" />
                }
            </TableHead>
        </TableRow>
    </TableHeader>
    <TableBody>
        {
            coins.map((coin: Coin, index: number) => {
                const usdQuote = coin.quotes.find((quote) => quote.name === "USD");
                return (
                    <TableRow>
                        <TableRow>
                            <TableCell>{index + 1}</TableCell>
                            <TableCell>{coin.name}</TableCell>
                            <TableCell class={`text-right ${getColorClass(usdQuote?.percentChange7d ?? 0)}`}>
                                {usdQuote?.percentChange7d.toFixed(2)} %
                            </TableCell>
                            <TableCell class={`text-right ${getColorClass(usdQuote?.percentChange30d ?? 0)}`}>
                                {usdQuote?.percentChange30d.toFixed(2)} %
                            </TableCell>
                            <TableCell class={`text-right ${getColorClass(usdQuote?.percentChange60d ?? 0)}`}>
                                {usdQuote?.percentChange60d.toFixed(2)} %
                            </TableCell>
                            <TableCell
                                class={`text-right pr-100 ${getColorClass(usdQuote?.percentChange90d ?? 0)}`}
                            >
                                {usdQuote?.percentChange90d.toFixed(2)} %
                            </TableCell>
                        </TableRow>
                    </TableRow>
                );
            })
        }
    </TableBody>
</Table>
