---
export const partial = true;
export const prerender = false;

import {
    Table,
    TableBody,
    TableCaption,
    TableCell,
    TableHead,
    TableHeader,
    TableRow,
} from "../../components/ui/table";

import { Icon } from "astro-icon/components";

import { getColorClass, getHighlightClass } from "@/lib/myutils";

const options = {
    method: "GET",
    headers: {
        accept: "application/json, text/plain, */*",
        "accept-language": "pl-PL,pl;q=0.7",
        Referer: "https://coinmarketcap.com/",
        "Referrer-Policy": "origin-when-cross-origin",
    },
};
const url = `https://api.coinmarketcap.com/data-api/v3/cryptocurrency/listing?start=1&limit=100&sortBy=rank&sortType=desc&convert=USD,BTC,ETH&cryptoType=all&tagType=all&audited=false&aux=ath,atl,high24h,low24h,num_market_pairs,cmc_rank,date_added,max_supply,circulating_supply,total_supply,volume_7d,volume_30d,self_reported_circulating_supply,self_reported_market_cap`;
const response = await fetch(url, options);
const data = await response.json();
const coins = data.data.cryptoCurrencyList;
// console.log(coins);

interface Quote {
    name: string;
    percentChange30d: number;
    percentChange60d: number;
    percentChange90d: number;
    // add other properties as needed
}

interface Coin {
    id: number;
    name: string;
    quotes: Quote[];
    // add other properties as needed
}

const threshold = 50;
---

<Table>
    <TableCaption>
        <a style="display: flex;justify-content: center; align-items: center;" href="#top"
            ><Icon size={16} name="line-md:upload-loop" />Go to the top of the page<Icon
                size={16}
                name="line-md:upload-loop"
            /></a
        >
    </TableCaption>
    <TableHeader>
        <TableRow>
            <TableHead class="w-[230px]">ID</TableHead>
            <TableHead>Name</TableHead>
            <TableHead class="text-right">30d %</TableHead>
            <TableHead class="text-right">60d %</TableHead>
            <TableHead class="text-right pr-100">90d %</TableHead>
        </TableRow>
    </TableHeader>
    <TableBody>
        {
            coins.map((coin: Coin, index: number) => {
                const usdQuote = coin.quotes.find((quote) => quote.name === "USD");
                return (
                    <TableRow>
                        <TableCell>{index + 1}</TableCell>
                        <TableCell>{coin.name}</TableCell>
                        <TableCell class={`text-right ${getColorClass(usdQuote?.percentChange30d ?? 0)}`}>
                            {usdQuote?.percentChange30d.toFixed(2)} %
                        </TableCell>
                        <TableCell class={`text-right ${getColorClass(usdQuote?.percentChange60d ?? 0)}`}>
                            {usdQuote?.percentChange60d.toFixed(2)} %
                        </TableCell>
                        <TableCell
                            class={`text-right pr-100 ${getColorClass(usdQuote?.percentChange90d ?? 0)}`}
                        >
                            {usdQuote?.percentChange90d.toFixed(2)} %
                        </TableCell>
                    </TableRow>
                );
            })
        }
    </TableBody>
</Table>
