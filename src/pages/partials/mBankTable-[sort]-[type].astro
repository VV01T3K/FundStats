---
export const partial = true;
export const prerender = false;

import {
    Table,
    TableBody,
    TableCaption,
    TableCell,
    TableHead,
    TableHeader,
    TableRow,
} from "../../components/ui/table";
import { Button } from "../../components/ui/button";

// import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

import { getColorClass } from "../../lib/myutils";

const { sort, type } = Astro.params as {
    sort: "1m" | "3m" | "6m" | "1y";
    type: "1" | "2" | "3" | "5";
};

const fund_type = {
    "1": "mieszane",
    "2": "dłużne",
    "3": "akcji",
    "5": "alternatywne",
};

const options = {
    method: "GET",
    headers: {
        accept: "application/json, text/plain, */*",
        "accept-language": "pl-PL,pl;q=0.7",
        Referer: "https://coinmarketcap.com/",
        "Referrer-Policy": "origin-when-cross-origin",
    },
};

const url = `https://www.mbank.pl/.includes/sfi/tab.inc.json`;

const response = await fetch(url, options);
const data = await response.json();

const dane = data.stock_quot.filter((item: TFI) => {
    return item.fund_type == Number(type);
});

dane.sort((b: TFI, a: TFI) => {
    switch (sort) {
        case "1m":
            return (
                Number((a?.StopaZw1m ?? 0).replace(",", ".")) - Number((b?.StopaZw1m ?? 0).replace(",", "."))
            );
        case "3m":
            return (
                Number((a?.StopaZw3m ?? 0).replace(",", ".")) - Number((b?.StopaZw3m ?? 0).replace(",", "."))
            );
        case "6m":
            return (
                Number((a?.StopaZw6m ?? 0).replace(",", ".")) - Number((b?.StopaZw6m ?? 0).replace(",", "."))
            );
        case "1y":
            return (
                Number((a?.StopaZw1r ?? 0).replace(",", ".")) - Number((b?.StopaZw1r ?? 0).replace(",", "."))
            );
    }
});

interface TFI {
    id: number;
    Data: string;
    Nazwa: string;
    fund_type: number;
    StopaZw1m: string;
    StopaZw3m: string;
    StopaZw6m: string;
    StopaZw1r: string;
}
---

<div>
    <menu class="flex justify-evenly">
        <Button
            variant={type === "3" ? "default" : "secondary"}
            class="text-lg transition-transform hover:scale-105 active:scale-95"
            hx-trigger=" click throttle:1s"
            hx-get=`/partials/mBankTable-${sort}-3`
            hx-swap="innerHTML transition:true"
            hx-indicator="#spinner"
            hx-target="#response-div"
            aria-label="change type to akcji"
        >
            akcji
        </Button>
        <Button
            variant={type === "1" ? "default" : "secondary"}
            class="text-lg transition-transform hover:scale-105 active:scale-95"
            hx-trigger=" click throttle:1s"
            hx-get=`/partials/mBankTable-${sort}-1`
            hx-swap="innerHTML transition:true"
            hx-indicator="#spinner"
            hx-target="#response-div"
            aria-label="change type to mieszane"
        >
            mieszane
        </Button>
        <Button
            variant={type === "2" ? "default" : "secondary"}
            class="text-lg transition-transform hover:scale-105 active:scale-95"
            hx-trigger=" click throttle:1s"
            hx-get=`/partials/mBankTable-${sort}-2`
            hx-swap="innerHTML transition:true"
            hx-indicator="#spinner"
            hx-target="#response-div"
            aria-label="change type to dłużne"
        >
            dłużne
        </Button>
        <Button
            variant={type === "5" ? "default" : "secondary"}
            class="text-lg transition-transform hover:scale-105 active:scale-95"
            hx-trigger=" click throttle:1s"
            hx-get=`/partials/mBankTable-${sort}-5`
            hx-swap="innerHTML transition:true"
            hx-indicator="#spinner"
            hx-target="#response-div"
            aria-label="change type to alternatywne"
        >
            alternatywne
        </Button>
    </menu>
    <div class="text-base mt-5 opacity-60">
        Data: {data.nDate}
    </div>
    <Table>
        <TableCaption>
            <a class="flex text-base justify-center items-center" href="#top"
                ><Icon size={16} name="line-md:upload-loop" />Go to the top of the page<Icon
                    size={16}
                    name="line-md:upload-loop"
                /></a
            >
        </TableCaption>
        <TableHeader>
            <TableRow>
                <TableHead class="w-[100px]">ID</TableHead>
                <TableHead>Name</TableHead>
                <TableHead
                    class={`text-right hover:text-blue-500 cursor-pointer ${sort === "1m" ? "text-violet-600" : ""}`}
                    hx-trigger=" click throttle:1s"
                    hx-get=`/partials/mBankTable-1m`
                    hx-swap="innerHTML transition:true"
                    hx-indicator="#spinner"
                    hx-target="#response-div"
                >
                    1m % {
                        sort === "1m" && (
                            <Icon style={"display: inline"} size={16} name="line-md:arrow-down" />
                        )
                    }
                </TableHead>
                <TableHead
                    class={`text-right hover:text-blue-500 cursor-pointer ${sort === "3m" ? "text-violet-600" : ""}`}
                    hx-trigger=" click throttle:1s"
                    hx-get=`/partials/mBankTable-3m`
                    hx-swap="innerHTML transition:true"
                    hx-indicator="#spinner"
                    hx-target="#response-div"
                >
                    3m % {
                        sort === "3m" && (
                            <Icon style={"display: inline"} size={16} name="line-md:arrow-down" />
                        )
                    }
                </TableHead>
                <TableHead
                    class=`text-right hover:text-blue-500 cursor-pointer ${sort === "6m" ? "text-violet-600" : ""}`
                    hx-trigger=" click throttle:1s"
                    hx-get="/partials/mBankTable-6m"
                    hx-swap="innerHTML transition:true"
                    hx-indicator="#spinner"
                    hx-target="#response-div"
                >
                    6m % {
                        sort === "6m" && (
                            <Icon style={"display: inline"} size={16} name="line-md:arrow-down" />
                        )
                    }
                </TableHead>
                <TableHead
                    class=`text-right pr-100 hover:text-blue-500 cursor-pointer ${sort === "1y" ? "text-violet-600" : ""}`
                    hx-trigger=" click throttle:1s"
                    hx-get="/partials/mBankTable-1y"
                    hx-swap="innerHTML transition:true"
                    hx-indicator="#spinner"
                    hx-target="#response-div"
                >
                    1y % {
                        sort === "1y" && (
                            <Icon style={"display: inline"} size={16} name="line-md:arrow-down" />
                        )
                    }
                </TableHead>
            </TableRow>
        </TableHeader>
        <TableBody>
            {
                dane.map((tfi: TFI, index: number) => {
                    return (
                        <TableRow>
                            <TableRow>
                                <TableCell>{index + 1}</TableCell>
                                <TableCell>
                                    {tfi.Nazwa}
                                    <p class="text-gray-500 text-xs">{tfi?.Data}</p>
                                </TableCell>
                                <TableCell
                                    class={`text-right ${getColorClass(Number((tfi?.StopaZw1m ?? 0).replace(",", ".")))}`}
                                >
                                    {Number((tfi?.StopaZw1m ?? 0).replace(",", "."))} %
                                </TableCell>
                                <TableCell
                                    class={`text-right ${getColorClass(Number((tfi?.StopaZw3m ?? 0).replace(",", ".")))}`}
                                >
                                    {Number((tfi?.StopaZw3m ?? 0).replace(",", "."))} %
                                </TableCell>
                                <TableCell
                                    class={`text-right ${getColorClass(Number((tfi?.StopaZw6m ?? 0).replace(",", ".")))}`}
                                >
                                    {Number((tfi?.StopaZw6m ?? 0).replace(",", "."))} %
                                </TableCell>
                                <TableCell
                                    class={`text-right pr-100 ${getColorClass(Number((tfi?.StopaZw1r ?? 0).replace(",", ".")))}`}
                                >
                                    {Number((tfi?.StopaZw1r ?? 0).replace(",", "."))} %
                                </TableCell>
                            </TableRow>
                        </TableRow>
                    );
                })
            }
        </TableBody>
    </Table>
</div>
