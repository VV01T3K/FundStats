---
import Layout from "@/layouts/Layout.astro";
import "@/styles/globals.css";
import { Button } from "@/components/ui/button";
// import { MyAsideCard } from "@/components/ui/MyAsideCard";
import { Icon } from "astro-icon/components";
// import Card from "../components/Card.astro";
import TableSlot from "@/components/TableSlot.astro";
import CoinImage from "@/components/CoinImage.astro";
---

<Layout title="CryptoStats">
    <main>
        <h1 class="upperlayer">Welcome to <span class="text-gradient">CryptoStats</span></h1>
        <p class="instructions upperlayer">
            <Button
                variant="outline"
                hx-trigger="load, click throttle:1s"
                hx-get="/partials/PaprikaTable-1y-50"
                hx-swap="innerHTML transition:true"
                hx-indicator="#spinner"
                hx-target="#response-div"
                aria-label="Get CoinPaprika Table"
            >
                <Icon size={64} class="but-icon" name="coinpaprika" />
            </Button>
            <Icon size={64} id="spinner" class="htmx-indicator ml-2" name="svg-spinners:clock" />
            <Button
                variant="outline"
                hx-trigger="click throttle:1s"
                hx-get="/partials/CoinmarketcapTable-30d"
                hx-swap="innerHTML transition:true"
                hx-indicator="#spinner"
                hx-target="#response-div"
                aria-label="Get CoinMarketCap Table"
            >
                <Icon size={64} name="coinmarketcap" />
            </Button>
        </p>
        <TableSlot id="response-div" />
    </main>
</Layout>

<style>
    html {
        scroll-behavior: smooth;
    }
    body {
        overflow-y: scroll; /* Show scrollbars */
    }
    Button {
        width: max-content;
        height: max-content;
        aspect-ratio: 1/1;
        border-width: 0.15rem;
        border-color: var(--accent-light);
        border-radius: 1rem;
        transition: scale 0.2s;
    }
    button:hover {
        background-color: rgba(164, 102, 240, 0.264);
    }
    button:active {
        scale: 0.95;
    }
    #spinner {
        position: absolute;
        transition:
            opacity 0.1s,
            scale 0.05s;
    }
    .htmx-indicator {
        scale: 0.5;
        opacity: 0;
    }
    .htmx-request .htmx-indicator,
    .htmx-request.htmx-indicator {
        scale: 1;
        opacity: 1;
    }
    .upperlayer {
        z-index: 10;
        position: relative;
    }
    main {
        min-height: 100vh;
        min-height: 100dvh;
        margin: auto;
        padding: 1rem;
        width: 100%;
        max-width: 70vw;
        width: max-content;
        min-width: min-content;
        color: white;
        font-size: 20px;
        line-height: 1.6;
    }
    .astro-a {
        position: absolute;
        top: 1.5rem;
        left: 50%;
        transform: translatex(-50%);
        width: 220px;
        height: auto;
        z-index: 0;
    }
    h1 {
        font-size: 4rem;
        font-weight: 700;
        line-height: 1;
        text-align: center;
        margin-bottom: 1em;
    }
    .text-gradient {
        background-image: linear-gradient(45deg, rgb(136, 58, 234), rgb(224, 204, 250) 50%, white 40%);
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
        text-fill-color: transparent;
        background-size: 400%;
        background-position: 0%;
        z-index: 100000;
    }
    .instructions {
        margin-bottom: 2rem;
        border: 1px solid rgba(var(--accent-light), 25%);
        background: linear-gradient(rgba(var(--accent-dark), 66%), rgba(var(--accent-dark), 33%));
        padding: 1.5rem;
        border-radius: 8px;
        display: flex;
        justify-content: space-evenly;
        align-items: center;
    }
</style>
