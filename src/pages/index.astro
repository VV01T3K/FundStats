---
import Layout from "../layouts/Layout.astro";
import "@/styles/globals.css";
import { Button } from "@/components/ui/button";
// import { MyAsideCard } from "@/components/ui/MyAsideCard";
import { Icon } from "astro-icon/components";
---

<Layout title="Welcome to Astro.">
    <main>
        <Icon class="astro-a" name="astro" />
        <h1 class="upperlayer">Welcome to <span class="text-gradient">Astro</span></h1>
        <p class="instructions upperlayer">
            <!-- !! add delay -->
            <Button
                hx-trigger="load, click"
                hx-target="p"
                hx-post="/partials/PaprikaTable"
                hx-swap="outerHTML transition:true settle:0.5s"
                hx-indicator="#spinner"
                hx-target="#response-div"
            >
                <Icon class="but-icon" name="coinpaprika" />
            </Button>
            <Button
                hx-trigger="load, click"
                hx-target="p"
                hx-post="/partials/PaprikaTable"
                hx-swap="outerHTML transition:true settle:0.5s"
                hx-indicator="#spinner"
                hx-target="#response-div"
            >
                <Icon name="coinmarketcap" />
            </Button>
            <Icon id="spinner" class="htmx-indicator ml-2" name="svg-spinners:pulse" />
        </p>
        <div id="response-div"></div>
    </main>
</Layout>

<style>
    .htmx-indicator {
        display: none;
    }
    .htmx-request .htmx-indicator,
    .htmx-request.htmx-indicator {
        display: inline-block;
    }

    .upperlayer {
        z-index: 10;
        position: relative;
    }
    main {
        min-height: 100vh;
        min-height: 100dvh;
        margin: auto;
        padding: 1rem;
        width: 800px;
        max-width: calc(100% - 2rem);
        color: white;
        font-size: 20px;
        line-height: 1.6;
    }
    .astro-a {
        position: absolute;
        top: 1.5rem;
        left: 50%;
        transform: translatex(-50%);
        width: 220px;
        height: auto;
        z-index: 0;
    }
    h1 {
        font-size: 4rem;
        font-weight: 700;
        line-height: 1;
        text-align: center;
        margin-bottom: 1em;
    }
    .text-gradient {
        background-image: linear-gradient(45deg, rgb(136, 58, 234), rgb(224, 204, 250) 30%, white 60%);
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
        text-fill-color: transparent;
        background-size: 400%;
        background-position: 0%;
        z-index: 100000;
    }
    .instructions {
        margin-bottom: 2rem;
        border: 1px solid rgba(var(--accent-light), 25%);
        background: linear-gradient(rgba(var(--accent-dark), 66%), rgba(var(--accent-dark), 33%));
        padding: 1.5rem;
        border-radius: 8px;
    }
    .instructions code {
        font-size: 0.8em;
        font-weight: bold;
        background: rgba(var(--accent-light), 12%);
        color: rgb(var(--accent-light));
        border-radius: 4px;
        padding: 0.3em 0.4em;
    }
    .instructions strong {
        color: rgb(var(--accent-light));
    }
    .link-card-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(24ch, 1fr));
        gap: 2rem;
        padding: 0;
    }
</style>
