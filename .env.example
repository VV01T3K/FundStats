# --- Local development (bun run dev / collect) ---
# Matches compose.dev.yaml (host port 55432 by default).
DATABASE_URL=postgres://fundstats:fundstats@127.0.0.1:55432/fundstats

# --- Production (compose.yaml) ---
# Required by compose.yaml; DATABASE_URL is built from it there.
POSTGRES_PASSWORD=change-me
# Host address and port the web app is published on. Loopback by default, for a
# reverse proxy on the same host; 0.0.0.0 exposes it on every interface.
FUNDSTATS_BIND=127.0.0.1
FUNDSTATS_PORT=3000

# --- Collector (apps/collector) ---
# false = never call upstream APIs.
COLLECTOR_ENABLED=true
# Per-source intervals, Effect duration syntax ("6 hours", "30 minutes"),
# at least 1 minute.
# Defaults: mbank 6 hours, crypto sources 30 minutes.
# COLLECTOR_INTERVAL_MBANK=6 hours
# COLLECTOR_INTERVAL_COINGECKO=30 minutes
# COLLECTOR_INTERVAL_COINPAPRIKA=30 minutes
# COLLECTOR_INTERVAL_COINMARKETCAP=30 minutes
# Raw upstream payloads are deleted after this many days (a positive integer).
RAW_PAYLOAD_RETENTION_DAYS=30

# --- Optional upstream keys ---
# CoinGecko demo key (raises the public rate limit).
COINGECKO_API_KEY=
# CoinMarketCap official API key; without it the unofficial web endpoint is used.
CMC_API_KEY=

# --- Advanced ---
# Both apps:
# DB_POOL_MAX=10   (a positive integer)
# DB_STATEMENT_TIMEOUT=30 seconds   (at least 1 second; migrations are exempt)
# Collector only:
# RUN_MIGRATIONS=true
# MIGRATIONS_DIR=packages/db/drizzle
